# ReadWise local environment variables
# Copy this file to .env and fill in the real values.

READWISE_ENV=production
READWISE_SECRET_KEY=replace_with_a_strong_random_secret
READWISE_DB_HOST=replace_with_database_host
READWISE_DB_PORT=3306
READWISE_DB_USER=replace_with_database_user
READWISE_DB_PASSWORD=replace_with_database_password
READWISE_DB_NAME=readwise_db
READWISE_ALLOWED_ORIGINS=https://your-production-domain.example.com
